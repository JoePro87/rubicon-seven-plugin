{
  "//": "TEMPLATE for native Windows (NO WSL). /vaarn-start writes this to <CAMPAIGN_DIR>/.mcp.json after replacing the placeholders. STRIP these '//' comment keys before writing.",
  "//ENGINE_DIR_WIN": "{{ENGINE_DIR_WIN}} = engine folder in Windows form (double backslashes), e.g. C:\\path\\to\\rubicon-seven-mcp.",
  "//CAMPAIGN_DIR_WIN": "{{CAMPAIGN_DIR_WIN}} = THIS campaign folder in Windows form, e.g. C:\\my-vaarn-game.",
  "//NO-WSLENV": "Native Windows crosses no WSL boundary, so WSLENV is intentionally ABSENT. RUBICON_CAMPAIGN_DIR is read directly by the engine.",
  "mcpServers": {
    "rubicon-seven": {
      "command": "{{ENGINE_DIR_WIN}}\\.venv\\Scripts\\python.exe",
      "args": ["{{ENGINE_DIR_WIN}}\\server.py"],
      "cwd": "{{ENGINE_DIR_WIN}}",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "RUBICON_CAMPAIGN_DIR": "{{CAMPAIGN_DIR_WIN}}"
      }
    }
  }
}
